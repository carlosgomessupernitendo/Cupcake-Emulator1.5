
package br.com.cupcake.emulator.core;

import java.io.File;
import java.io.FileInputStream;
import java.io.IOException;

public class ImageLoader {

    public ImageInfo load(File directory) throws IOException {

        if (directory == null) {
            throw new IOException("Diretorio nao informado.");
        }

        if (!directory.exists() || !directory.isDirectory()) {
            throw new IOException(
                    "A pasta de imagens nao foi encontrada: "
                    + directory.getAbsolutePath()
            );
        }

        File kernel = findImage(directory,
                "kernel-qemu", "Kernel-qemu");

        File ramdisk = findImage(directory,
                "ramdisk.img");

        File system = findImage(directory,
                "system.img");

        File userdata = findImage(directory,
                "userdata.img");

        validate(kernel);
        validate(ramdisk);
        validate(system);
        validate(userdata);

        return new ImageInfo(
                kernel,
                ramdisk,
                system,
                userdata
        );
    }

    private File findImage(
            File directory,
            String... names) throws IOException {

        for (String name : names) {
            File file = new File(directory, name);

            if (file.exists()) {
                return file;
            }
        }

        throw new IOException(
                "Imagem obrigatoria nao encontrada: "
                + names[0]
        );
    }

    private void validate(File file) throws IOException {

        if (!file.isFile()) {
            throw new IOException(
                    "Nao e um arquivo valido: " + file.getName()
            );
        }

        if (file.length() <= 0) {
            throw new IOException(
                    "Arquivo vazio: " + file.getName()
            );
        }

        if (!file.canRead()) {
            throw new IOException(
                    "Sem permissao de leitura: " + file.getName()
            );
        }

        FileInputStream input = null;

        try {
            input = new FileInputStream(file);
            if (input.read() == -1) {
                throw new IOException(
                        "Nao foi possivel ler: " + file.getName()
                );
            }
        } finally {
            if (input != null) {
                input.close();
            }
        }
    }
}

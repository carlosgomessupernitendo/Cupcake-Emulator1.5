
import java.io.File;
import java.util.List;

import br.com.cupcake.emulator.core.EmulatorLauncher;

public class EmulatorLauncherTest {

    public static void main(String[] args) {

        EmulatorLauncher launcher =
                new EmulatorLauncher();

        File qemu = new File(
                "emulator/bin/qemu-compatible"
        );

        if (!launcher.isAvailable(qemu)) {
            System.out.println(
                    "QEMU nao encontrado ou indisponivel."
            );
            return;
        }

        System.out.println(
                "Executavel QEMU encontrado!"
        );
    }
}
